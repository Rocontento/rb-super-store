#!/bin/sh
# Acciones del panel. Todos los parametros se validan contra listas cerradas.
. /app/lib.sh
printf 'Content-Type: application/json\r\n\r\n'

reply() { jq -n -c --argjson ok "$1" --arg msg "$2" '{ok: $ok, msg: $msg}'; }
param() { printf '%s\n' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
note() { echo "$(date '+%Y-%m-%d %H:%M:%S') [panel] $1" >> "$LOG"; }

# Solo POST con Content-Type JSON: otra web no puede mandarlo sin una comprobacion previa (CORS)
# que este servidor no acepta, asi que una pagina de otra app no puede lanzar acciones.
[ "$REQUEST_METHOD" = POST ] && [ "$CONTENT_TYPE" = application/json ] ||
  { reply false "Petición no válida."; exit 0; }
live >/dev/null || { reply false "Modo prueba: las acciones están desactivadas."; exit 0; }

# Una accion cada vez (cambiar zram o swap puede tardar minutos)
exec 9>/tmp/dh-action.lock
flock -n 9 || { reply false "Ya hay otra acción en curso; espera a que termine."; exit 0; }

case "$(param do)" in
  remount)
    # Tras montar, se vuelve a aplicar el swap del SSD (vive en el SSD)
    if out=$(mount_ssd 2>&1 && apply_swap 2>&1); then reply true "$out"; else reply false "$out"; fi
    ;;
  smart)
    dev=$(param dev); type=$(param type)
    case "$type" in short|long) ;; *) reply false "Tipo de test no válido."; exit 0 ;; esac
    tran=$(list_disks | awk -v d="$dev" '$1 == d {print $2}')
    [ -n "$tran" ] || { reply false "Disco no válido."; exit 0; }
    out=$(host /usr/sbin/smartctl $(smart_opt "$tran") -t "$type" "/dev/$dev" 2>&1)
    if printf '%s\n' "$out" | grep -qi "begun"; then
      reply true "Test $type iniciado en $dev. $(printf '%s\n' "$out" | grep -i 'wait\|complete after' | head -1)"
      smart_scan >/dev/null 2>&1 &
    else
      reply false "El disco no aceptó el test: $(printf '%s\n' "$out" | tail -2 | tr '\n' ' ')"
    fi
    ;;
  earlyoom)
    case "$(param op)" in
      stop)
        touch "$OOM_OFF"; eo_kill; note "EarlyOOM parado"
        reply true "EarlyOOM parado. Seguirá parado (también tras reiniciar) hasta que lo actives."
        ;;
      start|restart)
        rm -f "$OOM_OFF"; [ "$(param op)" = restart ] && eo_kill; note "EarlyOOM $(param op)"
        sleep 4
        if eo_pids >/dev/null; then reply true "EarlyOOM activo."; else reply false "EarlyOOM no arrancó; revisa el registro del contenedor."; fi
        ;;
      config)
        # Listas: el panel envia nombres separados por comas (%2C); se pasan a espacios y se validan
        names() { param "$1" | sed 's/%2[Cc]/,/g; s/+/ /g' | tr ',' ' ' | tr -s ' ' | sed 's/^ //; s/ $//'; }
        mem=$(param mem); swap=$(param swap); dryrun=$(param dryrun)
        avoid=$(names avoid); ignore=$(names ignore); prefer=$(names prefer)
        case "$mem" in [1-9]|[1-4][0-9]|50) ;; *) reply false "RAM mínima: entre 1 y 50 %."; exit 0 ;; esac
        case "$swap" in [1-9]|[1-9][0-9]|100) ;; *) reply false "Swap mínimo: entre 1 y 100 %."; exit 0 ;; esac
        case "$dryrun" in 0|1) ;; *) reply false "Modo prueba no válido."; exit 0 ;; esac
        for list in "$avoid" "$ignore" "$prefer"; do
          eo_valid_names "$list" || { reply false "Nombre de proceso no válido: solo letras, números, . _ - y 15 caracteres como máximo."; exit 0; }
        done
        printf 'mem=%s\nswap=%s\navoid=%s\nignore=%s\nprefer=%s\ndryrun=%s\n' \
          "$mem" "$swap" "$avoid" "$ignore" "$prefer" "$dryrun" > "$EO_CONF.tmp" && mv "$EO_CONF.tmp" "$EO_CONF"
        rm -f "$OOM_OFF"; eo_kill; note "Configuración guardada; EarlyOOM reiniciado"
        sleep 4
        if eo_pids >/dev/null; then reply true "Configuración guardada y EarlyOOM reiniciado."
        else reply false "Configuración guardada, pero EarlyOOM no arrancó; revisa el registro del contenedor."; fi
        ;;
      reset)
        rm -f "$EO_CONF"; eo_kill; note "Configuración restaurada por defecto"
        sleep 4
        if eo_pids >/dev/null; then reply true "Configuración por defecto restaurada y EarlyOOM reiniciado."
        else reply false "Configuración restaurada, pero EarlyOOM no arrancó; revisa el registro del contenedor."; fi
        ;;
      *) reply false "Operación no válida." ;;
    esac
    ;;
  zram)
    pct=$(param pct); algo=$(param algo)
    zram_valid "$pct $algo" || { reply false "Tamaño o compresión no válidos."; exit 0; }
    old=$(cat "$ZRAMCONF" 2>/dev/null)
    echo "$pct $algo" > "$ZRAMCONF"
    if out=$(apply_zram 2>&1); then
      # 75 % zstd es lo de Umbrel: se borra la eleccion y la app deja de gestionarlo
      [ "$pct $algo" = "75 zstd" ] && rm -f "$ZRAMCONF"
      reply true "$out"
    else
      # Si no se aplico, se recupera la eleccion anterior (o ninguna: lo de Umbrel)
      if [ -n "$old" ]; then echo "$old" > "$ZRAMCONF"; else rm -f "$ZRAMCONF"; fi
      reply false "$out"
    fi
    ;;
  swap)
    size=$(param size)
    case "$size" in 0|2|4|8) ;; *) reply false "Tamaño no válido."; exit 0 ;; esac
    old=$(cat "$SWAPCONF" 2>/dev/null)
    echo "$size" > "$SWAPCONF"
    if out=$(apply_swap 2>&1); then
      reply true "$out"
    else
      # Se recupera la eleccion anterior y se intenta volver a dejar el swap como estaba
      if [ -n "$old" ]; then echo "$old" > "$SWAPCONF"; apply_swap >/dev/null 2>&1; else rm -f "$SWAPCONF"; fi
      reply false "$out"
    fi
    ;;
  trash)
    [ "$(param confirm)" = yes ] || { reply false "Falta la confirmación."; exit 0; }
    if out=$(empty_trash 2>&1); then reply true "$out"; else reply false "$out"; fi
    ;;
  *)
    reply false "Acción desconocida."
    ;;
esac
collect 2>/dev/null
